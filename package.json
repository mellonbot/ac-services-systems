{
  "name": "ac-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "guard:schema": "node tools/ci/schema-guard.ts",
    "guard:test": "node --test \"packages/!(ui)/**/*.test.ts\" \"services/**/*.test.ts\" \"tools/**/*.test.ts\"",
    "guard:all": "npm run guard:schema && npm run guard:test",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/*.test.ts\"",
    "drive:s2-c4": "node tools/drive/drive-s2-c4.ts",
    "typecheck": "tsc -p tsconfig.json",
    "guard:lint": "eslint .",
    "emit": "node tools/ci/emit-schema.ts && node tools/ci/emit-surfaces.ts && node tools/ci/emit-sdk.ts",
    "sdk:generate": "node tools/ci/emit-sdk.ts",
    "sdk:check": "node tools/ci/emit-sdk.ts --check",
    "db:migrate": "node tools/ci/migrate.ts",
    "db:assert": "node tools/ci/migrate.ts --assert",
    "db:seed-test-logins": "node tools/ops/seed-test-logins.ts",
    "gateway": "node services/gateway/src/main.ts",
    "worker": "node services/worker/src/main.ts",
    "test:ui": "node --test \"packages/ui/**/*.test.ts\" \"apps/s[0-9]*/**/*.test.ts\"",
    "build:surface": "node tools/ci/build-surface.ts",
    "build:pages": "node tools/ci/build-pages.ts",
    "surfaces:check": "node tools/ci/emit-surfaces.ts --check",
    "drive:s1": "node tools/drive/drive-s1.ts",
    "drive:s6": "node tools/drive/drive-s6.ts",
    "drive:s8": "node tools/drive/drive-s8.ts",
    "drive:s3": "node tools/drive/drive-s3.ts",
    "drive:s5": "node tools/drive/drive-s5.ts",
    "drive:c3-amped": "node tools/drive/drive-c3-amped.ts",
    "audit:msa-terms": "node tools/ops/audit-msa-terms.ts"
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.0",
    "eslint": "^9.12.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "esbuild": "0.28.2"
  }
}
