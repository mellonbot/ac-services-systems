{
  "name": "ac-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "guard:schema": "node tools/ci/schema-guard.ts",
    "guard:test": "node --test \"packages/!(ui)/**/*.test.ts\" \"apps/!(s[0-9]*)/**/*.test.ts\" \"tools/**/*.test.ts\"",
    "guard:all": "npm run guard:schema && npm run guard:test",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/*.test.ts\"",
    "drive:s2-c4": "node tools/ci/drive-s2-c4.ts",
    "typecheck": "tsc -p tsconfig.json",
    "guard:lint": "eslint .",
    "emit": "node tools/ci/emit-schema.ts && node tools/ci/emit-surfaces.ts && node tools/ci/emit-sdk.ts",
    "sdk:generate": "node tools/ci/emit-sdk.ts",
    "sdk:check": "node tools/ci/emit-sdk.ts --check",
    "db:migrate": "node tools/ci/migrate.ts",
    "db:assert": "node tools/ci/migrate.ts --assert",
    "gateway": "node apps/gateway/src/main.ts",
    "worker": "node apps/worker/src/main.ts",
    "test:ui": "node --test \"packages/ui/**/*.test.ts\" \"apps/s[0-9]*/**/*.test.ts\"",
    "build:surface": "node tools/ci/build-surface.ts",
    "surfaces:check": "node tools/ci/emit-surfaces.ts --check"
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.0",
    "eslint": "^9.12.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "esbuild": "0.28.2"
  }
}
