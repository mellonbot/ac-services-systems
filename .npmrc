# Non-negotiable #3 — the API gateway is the sole access path.
# node-linker=isolated means a surface cannot resolve a dependency it did not
# declare. `import { Pool } from "pg"` inside apps/s3-* fails at resolution,
# before any lint rule gets a chance to run. The lint rule and the CI guard
# exist for the case where someone adds the dependency deliberately.
node-linker=isolated
hoist=false
strict-peer-dependencies=true
